class Solution {
public:
    int findLHS(vector<int>& nums) {
        int l=0;
        int n=nums.size();
        sort(nums.begin(),nums.end());
        int maxi=0;
        for(int r=0;r<nums.size();r++){
            int c=nums[r];
            while(l<r && nums[l]<c-1) l++;
            if(nums[l]==c-1) maxi=max(maxi,r-l+1);
        }
        return  maxi;
    }
};
