class Solution {
public:
    vector<int> maxSubsequence(vector<int>& nums, int k) {
        vector<int> n = nums;
        vector<int> res;

        sort(n.begin(), n.end());

        unordered_map<int, int> freq;
        for (int i = n.size() - k; i < n.size(); i++) {
            freq[n[i]]++;
        }

        for (int num : nums) {
            if (freq[num] > 0) {
                res.push_back(num);
                freq[num]--;
            }
            if (res.size() == k) break;
        }

        return res;
    }
};
