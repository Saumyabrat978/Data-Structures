class Solution {
public:
    int minMaxDifference(int num) {
        string s=to_string(num);
        string max="";
        string min="";
        int ele=0;
        for(int i=0;i<s.size();i++){
            if(s[i]!='9'){
                ele=s[i];
                break;
            }
        }
       for(int i=0;i<s.size();i++){
        if(ele==s[i]) max+='9';
        else max+=s[i];
       }
       for(int i=0;i<s.size();i++){
        if(s[0]==s[i]) min+='0';
        else min+=s[i];
       }
       return stoi(max)-stoi(min);
    }
};
