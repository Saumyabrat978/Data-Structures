class Solution {
public:
    int numOfUnplacedFruits(vector<int>& fruits, vector<int>& baskets) {
        int cnt=0;
        int n=baskets.size();
        for(int i=0;i<fruits.size();i++){
            int  flag=1;
            for(int j=0;j<n;j++){
                if(fruits[i]<=baskets[j]){
                    flag=0;
                    baskets[j]=0;
                    break;
                }
            }
            cnt+=flag;
        }
        return cnt;
    }
};
