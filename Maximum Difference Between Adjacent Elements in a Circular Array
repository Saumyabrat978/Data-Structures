class Solution {
public:
    int maxAdjacentDistance(vector<int>& nums) {
     int diff=INT_MIN;
     int n=nums.size();
     for(int i=0;i<n;i++){
        int ans=INT_MIN;
        if(i==n-1){
            ans=abs(nums[i]-nums[0]);
            diff=max(ans,diff);
        }
        else{
        ans=abs(nums[i]-nums[i+1]);
        diff=max(ans,diff);
        }
     }
     return diff;   
    }
};
